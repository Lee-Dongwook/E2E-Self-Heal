# Matches the local Postgres in product/docker-compose.yml. Copy to .env.
PRODUCT_API_DATABASE_URL=postgresql+psycopg://product:product@localhost:5432/product
# Case-insensitive: DEBUG, INFO, WARNING (WARN), ERROR, CRITICAL (FATAL), NOTSET.
PRODUCT_API_LOG_LEVEL=INFO
# Maximum accepted POST /v1/runs request size (bytes).
PRODUCT_API_MAX_UPLOAD_BYTES=1048576
# GitHub Actions must request this exact OIDC audience with id-token: write.
PRODUCT_API_OIDC_AUDIENCE=e2e-self-heal-product
# Optional private-beta allowlist, comma-separated by pydantic-settings.
PRODUCT_API_ALLOWED_REPOSITORY_OWNERS=[]
